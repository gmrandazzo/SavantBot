# Telegram Bot Token (Get this from @BotFather)
TELEGRAM_TOKEN=your_telegram_token_here

# Backend API URL
API_URL=http://0.0.0.0:8124

# Ollama Base URL
# Use http://ollama:11434 for the built-in Docker service
# Use http://host.docker.internal:11434 if Ollama is running on your host machine
# Use a full URL (e.g., http://192.168.1.50:11434) for a remote server
OLLAMA_BASE_URL=http://ollama:11434

# Comma-separated list of Telegram User IDs allowed to use the bot
# Leave empty to allow everyone (not recommended)
ALLOWED_USER_IDS=12345678,87654321
